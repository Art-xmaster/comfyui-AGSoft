# === ГЛОБАЛЬНОЕ ПРАВИЛО ===
# Все текстовые файлы — авто-определение, Windows-переносы
* text=auto eol=crlf

# === КОД И СТИЛИ ===
*.py   text eol=crlf
*.js   text eol=crlf
*.ts   text eol=crlf
*.html text eol=crlf
*.css  text eol=crlf

# === КОНФИГИ, ДАННЫЕ, ДОКУМЕНТАЦИЯ ===
*.json text eol=crlf
*.toml text eol=crlf
*.yaml text eol=crlf
*.yml  text eol=crlf
*.md   text eol=crlf
*.txt  text eol=crlf
*.csv  text eol=crlf

# === ИСКЛЮЧЕНИЯ ===
# CRLF ломает shell-скрипты
*.sh   text eol=lf
# bat работает только с CRLF
*.bat  text eol=crlf
# SVG — это текст, не binary
*.svg  text eol=crlf

# === БИНАРНИКИ (Гит не трогает, не диффит) ===
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.ttf    binary
*.woff   binary
*.woff2  binary
*.zip    binary
*.pdf    binary
*.exe    binary
*.dll    binary
*.sqlite binary
*.db     binary
*.npy    binary
*.npz    binary
*.pkl    binary
*.pth    binary
*.pt     binary
*.onnx   binary
